# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM: pick ONE provider ---
# gemini    -> free tier at https://aistudio.google.com/apikey
# openai    -> OpenAI, or any OpenAI-compatible API (Groq free tier: set OPENAI_BASE_URL=https://api.groq.com/openai/v1)
# anthropic -> Claude API (paid, https://console.anthropic.com)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# --- Embeddings (optional; leave EMBEDDING_PROVIDER=none for keyword-only search) ---
# Vectors are stored as 768 dimensions. Do not change without changing the SQL schema.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=gemini-embedding-001

# --- Evidence search: gdelt (free, no key) or brave (free tier key) ---
SEARCH_PROVIDER=gdelt
BRAVE_API_KEY=

# --- Protects /api/cron/ingest ---
CRON_SECRET=change-me
